NODE_ENV=production
TZ=Asia/Jakarta
# Railway automatically supplies PORT

# SMTP untuk fitur lupa password (wajib diisi agar reset email aktif)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Rafibot Management <your-email@gmail.com>
